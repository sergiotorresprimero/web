---
import { Image } from 'astro:assets';
import imagenHero from '../../assets/congreso.png'; 
---

<!-- SECCIÓN PRINCIPAL -->
<section class="relative bg-gradient-to-tr from-[#040508] via-[#121422] to-[#1c1d33] text-white overflow-hidden pt-8 pb-5 sm:py-12 lg:py-20 border-b border-white/10">
  
  <!-- EFECTO AMBIENTAL -->
  <div class="absolute -top-24 -left-24 w-96 h-96 bg-[#3a7bd5]/20 rounded-full blur-3xl pointer-events-none"></div>

  <!-- CONTENEDOR CENTRAL -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="flex flex-col lg:flex-row-reverse items-center justify-between gap-8 lg:gap-16">
      
      <!-- BLOQUE IMAGEN -->
      <div class="w-full lg:w-1/2 flex justify-center px-4 sm:px-0">
        <div class="relative group w-full max-w-[82%] sm:max-w-md lg:max-w-md">
          <div class="absolute -inset-1 bg-gradient-to-r from-[#3a7bd5] to-[#00d2ff] rounded-3xl blur-md opacity-30 group-hover:opacity-50 transition duration-300"></div>
          
          <Image
            src={imagenHero}
            alt="Afiche del Congreso 2026"
            class="relative w-full aspect-square object-cover rounded-2xl shadow-2xl border border-white/15 bg-slate-900"
          />
        </div>
      </div>

      <!-- BLOQUE INFORMATIVO -->
      <div class="w-full lg:w-1/2 flex flex-col items-center lg:items-start text-center lg:text-left space-y-5">
        
        <!-- ENCABEZADO -->
        <header class="flex flex-col items-center lg:items-start space-y-5">
          <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-white/10 border border-white/15 backdrop-blur-md shadow-inner">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <span class="text-xs font-bold text-slate-100 tracking-wider uppercase">
              Congreso 2026
            </span>
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.1]">
            El Siglo del <br class="hidden sm:inline" />
            Espíritu Santo
          </h1>
        </header>

        <!-- TEXTO DESCRIPTIVO -->
        <p class="text-sm sm:text-lg text-slate-300 font-normal max-w-xl leading-relaxed">
          Acompáñanos en la tercera edición de nuestro gran congreso anual.
        </p>

        <!-- TARJETA INFORMATIVA: Fecha -->
        <div class="flex flex-wrap justify-center lg:justify-start py-0.5 text-xs sm:text-sm font-semibold text-slate-200">
          <div class="flex items-center gap-2 bg-white/5 px-4 py-2 rounded-xl border border-white/10 backdrop-blur-xs">
            <svg class="w-4 h-4 text-[#00d2ff]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span>13, 14 y 15 de Noviembre</span>
          </div>
        </div>

        <!-- BOTONES DE ACCIÓN (CTA): Expandidos al 90% en móvil -->
        <div class="flex flex-col sm:flex-row items-center gap-5 sm:gap-4 pt-2 w-full max-w-[90%] sm:max-w-none">
          <a 
            href="/congreso-inscripcion" 
            class="w-full sm:w-auto bg-emerald-500 hover:bg-emerald-600 active:bg-emerald-700 text-white font-bold px-8 py-3 rounded-xl shadow-lg shadow-emerald-500/20 transition-all text-center text-sm active:scale-95"
          >
            Inscribirme Ahora
          </a>

          <a 
            href="/congreso2026"
            class="w-full sm:w-auto bg-white/10 hover:bg-white/15 text-white font-semibold px-8 py-3 rounded-xl border border-white/15 transition-all text-center text-sm active:scale-95"
          >
            Ver Detalles
          </a>
        </div>

      </div>

    </div>
  </div>
</section>