<!-- ======================================================= -->
<!-- SECCIÓN REUNIONES (Diseño Ultra Minimalista y Moderno)  -->
<!-- ======================================================= -->
<section class="bg-white pt-2 pb-10 px-4 sm:px-6 lg:px-8 border-b border-slate-100">
  <div class="max-w-7xl mx-auto">
    
    <!-- CONTENEDOR EN GRID -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center">
      
      <!-- ========================================== -->
      <!-- COLUMNA IZQUIERDA: TITULO CON TU TAMAÑO    -->
      <!-- ========================================== -->
      <div class="lg:col-span-5 py-4">
        <!-- Mantenemos el tamaño sutil que ya ajustaste -->
        <h2 class="text-2xl md:text-3xl font-extrabold text-[#0f2547] tracking-tight uppercase">
          Nuestras Reuniones
        </h2>
        <div class="h-1 w-16 bg-[#00a86b] rounded-full mt-2"></div>
      </div>

      <!-- ========================================== -->
      <!-- COLUMNA DERECHA: TARJETAS MINIMALISTAS     -->
      <!-- ========================================== -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-8">
        
        <!-- TARJETA 1: DOMINGO (Estilo Línea Lateral) -->
        <!-- 
          - bg-transparent: Elimina el bloque pesado.
          - border-l-2 border-slate-200: Una línea fina y elegante a la izquierda.
          - hover:border-[#00a86b]: La línea se ilumina en verde con una transición suave.
          - pl-4: Desplaza el contenido para separarlo de la línea.
        -->
        <div class="flex items-start gap-3 bg-transparent border-l-2 border-slate-200 pl-4 hover:border-[#00a86b] transition-all duration-300 group">
          <!-- Ícono limpio y minimalista (sin círculo de fondo) -->
          <div class="text-slate-400 group-hover:text-[#00a86b] transition-colors duration-300 mt-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          
          <div class="text-left">
            <!-- LÍNEA 1: Texto principal con tipografía fina y limpia -->
            <h4 class="text-base font-bold text-[#0f2547] tracking-tight">
              Celebración <span class="text-[#00a86b] font-extrabold">Domingo</span>
            </h4>
            <!-- LÍNEA 2: Horarios secundarios discretos -->
            <p class="text-xs font-medium text-slate-400 mt-0.5 tracking-wide">
              9:00 AM y 4:00 PM
            </p>
          </div>
        </div>

        <!-- TARJETA 2: MIÉRCOLES (Estilo Línea Lateral) -->
        <div class="flex items-start gap-3 bg-transparent border-l-2 border-slate-200 pl-4 hover:border-[#00a86b] transition-all duration-300 group">
          <!-- Ícono limpio y minimalista (sin círculo de fondo) -->
          <div class="text-slate-400 group-hover:text-[#00a86b] transition-colors duration-300 mt-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          
          <div class="text-left">
            <!-- LÍNEA 1: Texto principal -->
            <h4 class="text-base font-bold text-[#0f2547] tracking-tight">
              Celebración <span class="text-[#00a86b] font-extrabold">Miércoles</span>
            </h4>
            <!-- LÍNEA 2: Horarios secundarios discretos -->
            <p class="text-xs font-medium text-slate-400 mt-0.5 tracking-wide">
              7:00 PM
            </p>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>