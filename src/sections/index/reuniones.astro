<!-- ======================================================= -->
<!-- SECCIÓN CELEBRACIONES (Borde Resaltado + Glassmorphism)  -->
<!-- ======================================================= -->
<section class="relative z-10 -mt-6 mb-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-5xl mx-auto">
    
    <!-- CONTENEDOR CON BORDE RESALTADO (RING + BORDER DE ALTO CONTRASTE) -->
    <div class="bg-white/95 backdrop-blur-md border-2 border-slate-300/90 hover:border-emerald-500/50 ring-4 ring-slate-900/5 rounded-2xl p-4 sm:p-5 shadow-[0_15px_35px_rgba(15,23,42,0.08)] transition-all duration-300 relative overflow-hidden">
      
      <!-- Luz de fondo sutil -->
      <div class="absolute -top-12 -right-12 w-32 h-32 bg-sky-400/10 rounded-full blur-2xl pointer-events-none"></div>

      <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-4 sm:gap-6">
        
        <!-- IZQUIERDA: BADGE + TÍTULO -->
        <div class="flex items-center gap-3 shrink-0 text-center md:text-left">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 border-2 border-emerald-500/30 text-emerald-700 text-[10px] font-black uppercase tracking-widest shrink-0 shadow-xs">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            Horarios
          </div>
          <h2 class="text-base sm:text-lg font-black text-slate-900 tracking-tight uppercase leading-none">
            Nuestras Celebraciones
          </h2>
        </div>

        <!-- DERECHA: TARJETAS CON BORDES DEFINIDOS -->
        <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto">
          
          <!-- DOMINGO -->
          <div class="bg-slate-50 hover:bg-white border-2 border-slate-200 hover:border-emerald-500 transition-all pl-3.5 pr-2 py-2 rounded-xl shadow-xs flex items-center justify-between gap-3 w-full sm:w-auto">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.5)] shrink-0"></span>
              <h3 class="text-xs font-black text-slate-800 uppercase tracking-wide">Domingo</h3>
            </div>
            <div class="flex items-center gap-1 shrink-0">
              <span class="bg-emerald-600 text-white text-[11px] font-black px-2.5 py-1 rounded-lg shadow-xs">
                9:00 AM
              </span>
              <span class="bg-emerald-600 text-white text-[11px] font-black px-2.5 py-1 rounded-lg shadow-xs">
                4:00 PM
              </span>
            </div>
          </div>

          <!-- MIÉRCOLES -->
          <div class="bg-slate-50 hover:bg-white border-2 border-slate-200 hover:border-sky-500 transition-all pl-3.5 pr-2 py-2 rounded-xl shadow-xs flex items-center justify-between gap-3 w-full sm:w-auto">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-sky-500 shadow-[0_0_8px_rgba(14,165,233,0.5)] shrink-0"></span>
              <h3 class="text-xs font-black text-slate-800 uppercase tracking-wide">Miércoles</h3>
            </div>
            <div class="flex items-center shrink-0">
              <span class="bg-sky-600 text-white text-[11px] font-black px-2.5 py-1 rounded-lg shadow-xs">
                7:00 PM
              </span>
            </div>
          </div>

        </div>

      </div>
    </div>

  </div>
</section>