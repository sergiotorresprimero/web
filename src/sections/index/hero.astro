---
import { Image } from 'astro:assets';
import imagenHero from '../../assets/congreso2026.png'; 
// IMPORTA AQUÍ TU IMAGEN PNG
import iconoMapa from '../../assets/icono-mapa4.png'; 
---

<!-- SECCIÓN HERO COMPACTA Y ELEGANTE -->
<section class="relative bg-[#07090e] text-white overflow-hidden py-8 lg:py-12 border-b border-white/10">
  
  <!-- EFECTOS AMBIENTALES DE LUZ -->
  <div class="absolute top-1/2 left-1/4 -translate-y-1/2 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/2 right-10 -translate-y-1/2 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-4 lg:px-3 relative z-10">
    
    <!-- GRID PRINCIPAL DE 2 COLUMNAS -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- COLUMNA IMAGEN -->
      <div class="order-1 lg:order-2 lg:col-span-5 flex justify-center lg:justify-end">
        <div class="relative w-full max-w-sm lg:max-w-none">
          <div class="absolute -inset-1 bg-gradient-to-b from-cyan-500/20 to-emerald-500/20 rounded-3xl blur-xl opacity-90"></div>
          <Image
            src={imagenHero}
            alt="Afiche del Congreso 2026"
            class="relative w-full aspect-square object-cover rounded-xl shadow-3xl"
          />
        </div>
      </div>

      <!-- COLUMNA IZQUIERDA/TEXTO -->
      <div class="order-2 lg:order-1 lg:col-span-7 flex flex-col justify-between space-y-6">
        
        <!-- HEADER & TÍTULOS -->
        <div class="space-y-3 text-center lg:text-left">
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white uppercase leading-none">
            Congreso 2026
          </h1>
          <h2 class="text-4xl sm:text-4xl font-extrabold text-yellow-200 drop-shadow-[0_2px_8px_rgba(250,204,21,0.3)] tracking-normal">
            El Siglo del Espíritu Santo
          </h2>
          <p class="py-1"></p>
          <p class="text-lg text-slate-300 max-w-xl mx-auto lg:mx-0 leading-relaxed">
            Llega la tercera edición de nuestro congreso anual.
          </p>
        </div>

        <!-- ELEMENTOS EN LA MISMA LÍNEA: FECHA, UBICACIÓN Y BOTÓN MAPA -->
        <div class="flex flex-col sm:flex-row items-stretch gap-3">
          
          <!-- CARD 1: FECHA -->
          <div class="flex items-center justify-center sm:justify-start gap-2.5 px-4 py-3 sm:py-3 rounded-2xl bg-white/[0.03] border border-white/10 backdrop-blur-md shrink-0">
            <svg class="w-5 h-5 sm:w-4 sm:h-4 text-cyan-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span class="text-base sm:text-xs md:text-sm font-semibold text-slate-300 sm:text-slate-300 whitespace-nowrap">13, 14 y 15 de Noviembre</span>
          </div>

          <!-- CARD 2: UBICACIÓN -->
          <div class="flex items-center justify-center sm:justify-start gap-2.5 px-4 py-3 sm:py-3 rounded-2xl bg-white/[0.03] border border-white/10 backdrop-blur-md flex-1 min-w-0">
            <svg class="w-5 h-5 sm:w-4 sm:h-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span class="text-base sm:text-xs md:text-sm font-semibold text-slate-300 sm:text-slate-300 whitespace-nowrap">Cra 77 No. 1A - 09 | Cali - Colombia</span>
          </div>

          <!-- BOTÓN MAPA ACTUALIZADO CON LA IMAGEN PNG -->
          <a 
            href="https://maps.app.goo.gl/mihCMBD8XNPv7kbS9" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-4 py-3.5 sm:py-3 rounded-2xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-base sm:text-xs md:text-sm transition-all shadow-lg shadow-emerald-500/20 whitespace-nowrap shrink-0"
          >
            <span>Cómo llegar</span>
            <!-- AQUÍ USAMOS TU PNG -->
            <Image 
              src={iconoMapa} 
              alt="" 
              class="w-5 h-5 sm:w-4 sm:h-4 shrink-0 object-contain" 
              width={40} 
              height={40}
              aria-hidden="true"
            />
          </a>

        </div>

        <!-- PANEL DE HORARIOS DE SESIONES -->
        <div class="p-5 sm:p-6 rounded-2xl bg-white/[0.02] border border-white/10 backdrop-blur-md space-y-5">
          <!-- Título -->
          <div class="flex items-center justify-center lg:justify-start gap-2.5">
            <svg class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <h3 class="text-md sm:text-sm font-bold uppercase tracking-wide text-slate-300">Horarios Congreso</h3>
          </div>

          <!-- GRID DE 3 DÍAS -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4">
            <!-- DÍA 1 -->
            <div class="p-4 rounded-xl bg-cyan-950/20 border border-cyan-500/20 flex flex-col justify-center items-center sm:items-start">
              <div class="flex items-center gap-2 mb-3">
                <div class="w-1.5 h-1.5 rounded-full bg-cyan-400 shadow-[0_0_8px_rgba(34,211,238,0.8)]"></div>
                <span class="text-[16px] sm:text-sm font-semibold tracking-wider sm:tracking-widest text-cyan-200/90">
                  Día 1 · Viernes 13
                </span>
              </div>
              <div class="flex items-baseline gap-1.5">
                <span class="text-2xl font-black text-white tracking-tighter">7:00</span>
                <span class="text-sm font-bold text-cyan-400">PM</span>
              </div>
            </div>
            <!-- DÍA 2 -->
            <div class="p-4 rounded-xl bg-cyan-950/20 border border-cyan-500/20 flex flex-col justify-center items-center sm:items-start">
              <div class="flex items-center gap-2 mb-3">
                <div class="w-1.5 h-1.5 rounded-full bg-cyan-400 shadow-[0_0_8px_rgba(34,211,238,0.8)]"></div>
                <span class="text-[15px] sm:text-sm font-semibold tracking-widest text-cyan-200/90">
                  Día 2 · Sábado 14
                </span>
              </div>
              <div class="flex items-baseline gap-1.5">
                <span class="text-2xl font-black text-white tracking-tighter">4:00</span>
                <span class="text-sm font-bold text-cyan-400">PM</span>
              </div>
            </div>
            <!-- DÍA 3 -->
            <div class="p-4 sm:px-3 rounded-xl bg-cyan-950/20 border border-cyan-500/20 flex flex-col justify-center items-center sm:items-start">
              <div class="flex items-center gap-2 mb-3">
                <div class="w-1.5 h-1.5 rounded-full bg-cyan-400 shadow-[0_0_8px_rgba(34,211,238,0.8)]"></div>
                <span class="text-[15px] sm:text-sm font-semibold tracking-widest text-cyan-200/90">
                  Día 3 · Domingo 15
                </span>
              </div>
              <div class="flex items-center justify-around sm:justify-between sm:gap-2 w-full px-2 sm:px-0">
                <div class="flex items-baseline gap-1">
                  <span class="text-2xl font-black text-white tracking-tighter">9:00</span>
                  <span class="text-sm font-bold text-cyan-400">AM</span>
                </div>
                <div class="h-4 w-px bg-white/10 hidden sm:block"></div>
                <div class="flex items-baseline gap-1">
                  <span class="text-2xl font-black text-white tracking-tighter">4:00</span>
                  <span class="text-sm font-bold text-cyan-400">PM</span>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>