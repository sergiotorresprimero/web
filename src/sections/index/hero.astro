---
import { Image } from 'astro:assets';
import imagenHero from '../../assets/congreso2026.png'; 
---

<!-- SECCIÓN HERO COMPACTA Y ELEGANTE -->
<section class="relative bg-[#07090e] text-white overflow-hidden py-8 lg:py-12 border-b border-white/10">
  
  <!-- EFECTOS AMBIENTALES DE LUZ -->
  <div class="absolute top-1/2 left-1/4 -translate-y-1/2 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/2 right-10 -translate-y-1/2 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- GRID PRINCIPAL DE 2 COLUMNAS -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- COLUMNA IMAGEN (ORDER-1 EN MÓVIL -> ARRIBA | ORDER-2 EN DESKTOP -> DERECHA) -->
      <div class="order-1 lg:order-2 lg:col-span-5 flex justify-center lg:justify-end">
        <div class="relative w-full max-w-sm lg:max-w-none">
          <!-- Glow exterior suave -->
          <div class="absolute -inset-1 bg-gradient-to-b from-cyan-500/20 to-emerald-500/20 rounded-3xl blur-xl opacity-70"></div>
          
          <Image
            src={imagenHero}
            alt="Afiche del Congreso 2026"
            class="relative w-full aspect-square object-cover rounded-2xl shadow-2xl border border-white/15 bg-slate-900"
          />
        </div>
      </div>

      <!-- COLUMNA IZQUIERDA/TEXTO (ORDER-2 EN MÓVIL -> ABAJO | ORDER-1 EN DESKTOP -> IZQUIERDA) -->
      <div class="order-2 lg:order-1 lg:col-span-7 flex flex-col justify-between space-y-6">
        
        <!-- HEADER & TÍTULOS -->
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold tracking-wide uppercase">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Entrada Libre
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white uppercase leading-none">
            Congreso <span class="bg-gradient-to-r from-cyan-400 via-emerald-400 to-teal-300 bg-clip-text text-transparent">2026</span>
          </h1>

          <h2 class="text-2xl sm:text-3xl font-bold text-slate-200 tracking-tight">
            El Siglo del Espíritu Santo
          </h2>

          <p class="text-sm sm:text-base text-slate-400 max-w-xl leading-relaxed">
            Llega la tercera edición de nuestro congreso anual.
          </p>
        </div>

        <!-- DOS CARDS SEPARADAS EN LA MISMA LÍNEA: FECHA Y UBICACIÓN -->
        <div class="flex flex-col sm:flex-row items-stretch gap-3">
          
          <!-- CARD 1: FECHA -->
          <div class="flex items-center gap-2.5 px-4 py-3 rounded-2xl bg-white/[0.03] border border-white/10 backdrop-blur-md">
            <svg class="w-4 h-4 text-cyan-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span class="text-xs sm:text-sm font-semibold text-slate-200 whitespace-nowrap">13, 14 y 15 de Noviembre</span>
          </div>

          <!-- CARD 2: UBICACIÓN + BOTÓN MAPA -->
          <div class="flex items-center justify-between gap-3 p-2 pl-4 rounded-2xl bg-white/[0.03] border border-white/10 backdrop-blur-md flex-1 min-w-0">
            <div class="flex items-center gap-2 text-xs sm:text-sm text-slate-300 min-w-0">
              <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <span class="truncate">Cra 77 No. 1A - 09, Cali - Colombia</span>
            </div>

            <!-- BOTÓN MAPA -->
            <a 
              href="https://maps.google.com" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs transition-all shadow-lg shadow-emerald-500/20 whitespace-nowrap shrink-0"
            >
              <span>¿Cómo llegar?</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>
          </div>

        </div>

        <!-- PANEL DE HORARIOS DE SESIONES (NUEVO ENFOQUE PRO) -->
        <div class="p-4 sm:p-5 rounded-2xl bg-white/[0.02] border border-white/10 backdrop-blur-md space-y-3">
          
          <div class="flex items-center justify-between border-b border-white/10 pb-2.5">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <h3 class="text-xs font-black uppercase tracking-widest text-slate-300">Horarios de Reuniones</h3>
            </div>
            <span class="text-[10px] uppercase tracking-wider text-slate-400 font-semibold bg-white/5 px-2 py-0.5 rounded-full border border-white/5">
              Entrada Libre
            </span>
          </div>

          <!-- GRID DE 3 DÍAS -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            
            <!-- DÍA 1 -->
            <div class="p-3 rounded-xl bg-white/[0.02] border border-white/5 hover:border-emerald-500/30 transition-colors">
              <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-400 block mb-1">
                Día 1 · Vie 13
              </span>
              <div class="flex items-baseline gap-1.5">
                <span class="text-lg font-extrabold text-white">7:00</span>
                <span class="text-xs font-semibold text-slate-400">PM</span>
              </div>
              <p class="text-[11px] text-slate-400 mt-0.5">Apertura Oficial</p>
            </div>

            <!-- DÍA 2 -->
            <div class="p-3 rounded-xl bg-white/[0.02] border border-white/5 hover:border-cyan-500/30 transition-colors">
              <span class="text-[10px] font-bold uppercase tracking-wider text-cyan-400 block mb-1">
                Día 2 · Sáb 14
              </span>
              <div class="flex items-baseline gap-1.5">
                <span class="text-lg font-extrabold text-white">4:00</span>
                <span class="text-xs font-semibold text-slate-400">PM</span>
              </div>
              <p class="text-[11px] text-slate-400 mt-0.5">Sesión Principal</p>
            </div>

            <!-- DÍA 3 -->
            <div class="p-3 rounded-xl bg-gradient-to-br from-emerald-500/10 to-cyan-500/10 border border-emerald-500/20 relative overflow-hidden">
              <span class="text-[10px] font-bold uppercase tracking-wider text-teal-300 block mb-1">
                Día 3 · Dom 15
              </span>
              <div class="space-y-1">
                <div class="flex items-center justify-between">
                  <div class="flex items-baseline gap-1">
                    <span class="text-sm font-extrabold text-white">9:00</span>
                    <span class="text-[10px] font-semibold text-slate-400">AM</span>
                  </div>
                  <span class="text-[9px] text-slate-300">Mañana</span>
                </div>
                
                <div class="flex items-center justify-between border-t border-white/10 pt-1 mt-1">
                  <div class="flex items-baseline gap-1">
                    <span class="text-sm font-extrabold text-emerald-300">4:00</span>
                    <span class="text-[10px] font-semibold text-emerald-400">PM</span>
                  </div>
                  <span class="text-[9px] font-extrabold text-emerald-300 uppercase tracking-tight bg-emerald-500/20 px-1.5 py-0.2 rounded">
                    Gran Cierre
                  </span>
                </div>
              </div>
            </div>

          </div>

        </div>

      </div>

    </div>

  </div>
</section>