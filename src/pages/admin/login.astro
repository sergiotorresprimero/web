---
// src/pages/admin/login.astro
import Layout from '../../layouts/Layout.astro';
import LoginForm from '../../sections/admin/LoginForm.svelte';
---

<Layout title="Acceso Administrativo - Congreso 2026">
  <main class="min-h-screen bg-gradient-to-br from-slate-900 via-gray-900 to-slate-950 flex items-center justify-center p-4">
    <div class="w-full max-w-md bg-slate-800/90 backdrop-blur-md p-8 rounded-2xl shadow-2xl border border-slate-700/60">
      
      <!-- Encabezado Institucional -->
      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-indigo-500/10 text-indigo-400 mb-4 border border-indigo-500/20">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </div>
        <h1 class="text-xl font-bold text-white tracking-wide">Control de asistencia Congreso</h1>
        <p class="text-xs font-medium text-indigo-400 mt-1 uppercase tracking-wider">Uso exclusivo para administradores de la iglesia</p>
      </div>

      <!-- Formulario Svelte -->
      <LoginForm client:load />

    </div>
  </main>
</Layout>