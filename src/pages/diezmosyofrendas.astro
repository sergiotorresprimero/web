---
// 1. Importa el Layout general de tu proyecto (ajusta la ruta si es necesario, ej: '../layouts/Layout.astro')
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

// Aquí colocamos la versión completa y detallada que hicimos en tono claro
---

<Layout title="Diezmos y Ofrendas | Centro Mundial de Evangelismo">
  
  <!-- Contenedor principal para empujar el footer hacia abajo si hay poco contenido -->
  <main class="min-h-screen bg-slate-50 text-slate-600 flex flex-col justify-between">
    
    <!-- SECCIÓN DE DIEZMOS Y OFRENDAS (Detallada y en Tono Claro) -->
    <section class="py-16 md:py-24 relative overflow-hidden flex-grow">
      <!-- Sutiles destellos de color de fondo -->
      <div class="absolute top-1/4 left-10 w-[300px] h-[300px] bg-amber-200/20 blur-[120px] rounded-full pointer-events-none"></div>
      <div class="absolute bottom-1/4 right-10 w-[300px] h-[300px] bg-blue-200/20 blur-[120px] rounded-full pointer-events-none"></div>

      <div class="max-w-6xl mx-auto px-6 relative z-10">
        
        <!-- Botón para regresar al Inicio rápidamente -->
        <div class="mb-8">
          <a href="/" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-500 hover:text-slate-900 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Volver al inicio
          </a>
        </div>

        <!-- Encabezado de la Sección -->
        <div class="text-center max-w-2xl mx-auto mb-12 md:mb-16">
          <span class="text-xs font-bold tracking-widest text-amber-600 uppercase mb-3 block">Generosidad</span>
          <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">
            Diezmos y Ofrendas
          </h1>
          <div class="h-1 w-12 bg-amber-500 mx-auto mt-4 rounded-full"></div>
          <p class="mt-6 text-base text-slate-600 leading-relaxed italic">
            "Cada uno dé como propuso en su corazón: no con tristeza, ni por necesidad, porque Dios ama al dador alegre." 
            <span class="block mt-2 font-semibold text-slate-800 not-italic">— 2 Corintios 9:7</span>
          </p>
        </div>

        <!-- Opciones de Ofrenda (Grid de Tarjetas Claras) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
          
          <!-- Opción 1: Transferencia Bancaria -->
          <div class="bg-white border border-slate-200 rounded-2xl p-8 hover:border-amber-500/40 transition-all duration-300 shadow-sm hover:shadow-md flex flex-col justify-between">
            <div class="space-y-4">
              <!-- Icono -->
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-amber-50 text-amber-600 border border-amber-100">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
              </div>
              <h3 class="text-xl font-bold text-slate-900">Transferencia Bancaria</h3>
              <p class="text-sm text-slate-500 leading-relaxed">
                Puedes realizar tus aportes directamente desde tu aplicación bancaria a nuestra cuenta oficial.
              </p>
              
              <!-- Detalles de la Cuenta -->
              <div class="bg-slate-50 rounded-xl p-4 border border-slate-200/60 space-y-2 text-sm">
                <div class="flex justify-between">
                  <span class="text-slate-500">Banco:</span>
                  <span class="font-semibold text-slate-800">Bancolombia</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-500">Tipo de Cuenta:</span>
                  <span class="font-semibold text-slate-800">Ahorros</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-500">Número:</span>
                  <span class="font-bold text-amber-600 font-mono tracking-wider">123-456789-01</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-500">Titular:</span>
                  <span class="font-semibold text-slate-800 text-right">Centro Mundial de Evangelismo</span>
                </div>
                <div class="flex justify-between border-t border-slate-200 pt-2 mt-2">
                  <span class="text-slate-500">NIT / CC:</span>
                  <span class="font-semibold text-slate-800">900.123.456-7</span>
                </div>
              </div>
            </div>
            
            <div class="mt-6 text-xs text-slate-400 text-center">
              * Recuerda enviar el soporte de tu transferencia al correo de contacto.
            </div>
          </div>

          <!-- Opción 2: Pago en Línea -->
          <div class="bg-white border border-slate-200 rounded-2xl p-8 hover:border-amber-500/40 transition-all duration-300 shadow-sm hover:shadow-md flex flex-col justify-between">
            <div class="space-y-4">
              <!-- Icono -->
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-blue-50 text-blue-600 border border-blue-100">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                </svg>
              </div>
              <h3 class="text-xl font-bold text-slate-900">Ofrendar en Línea</h3>
              <p class="text-sm text-slate-500 leading-relaxed">
                Ofrenda de manera segura utilizando PSE, tarjetas de crédito/débito o billeteras digitales desde cualquier lugar.
              </p>
              
              <div class="space-y-3 pt-2">
                <div class="flex items-center gap-3 text-sm text-slate-700">
                  <span class="w-1.5 h-1.5 bg-amber-500 rounded-full"></span>
                  <span>Compatible con PSE (Nequi, Daviplata, etc.)</span>
                </div>
                <div class="flex items-center gap-3 text-sm text-slate-700">
                  <span class="w-1.5 h-1.5 bg-amber-500 rounded-full"></span>
                  <span>Tarjetas de Crédito Visa y Mastercard</span>
                </div>
                <div class="flex items-center gap-3 text-sm text-slate-700">
                  <span class="w-1.5 h-1.5 bg-amber-500 rounded-full"></span>
                  <span>Transacciones 100% encriptadas y seguras</span>
                </div>
              </div>
            </div>

            <!-- Botón de Ofrendar -->
            <div class="mt-8">
              <a 
                href="#" 
                onClick="event.preventDefault()" 
                class="block w-full py-3.5 px-6 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-white font-bold text-center text-sm tracking-wide shadow-md hover:shadow-amber-500/10 active:scale-[0.98] transition-all duration-200"
              >
                Ofrendar Ahora
              </a>
            </div>
          </div>

        </div>

      </div>
    </section>
    
  </main>
</Layout>