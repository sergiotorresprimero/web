---
import { Image } from 'astro:assets';
// Asegúrate de tener tus imágenes en la ruta correcta de tu proyecto
import logo from '../assets/logo.png'; 
import mapaImg from '../assets/mapa.png'; 
---

<footer id="reuniones" class="bg-[#030611] text-slate-400 border-t border-white/5 relative overflow-hidden">
  <!-- Luz ambiental en la base -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[500px] h-[150px] bg-blue-950/20 blur-[100px] rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 pt-8 md:pt-10 pb-2 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 items-start">
      
      <!-- COLUMNA 1: LOGO E INFORMACIÓN GENERAL -->
      <div class="space-y-4 self-start flex flex-col items-center text-center w-full">
        <div class="flex items-center justify-center gap-3 h-10">
          <Image 
            src={logo} 
            alt="Centro Mundial de Evangelismo" 
            class="w-10 h-10 object-contain brightness-110"
          />
          <span class="text-[min(4vw,20px)] font-bold tracking-normal whitespace-nowrap text-white text-center block leading-none">
        Centro Mundial de Evangelismo
      </span>
        </div>
        <div class="text-sm text-slate-400 leading-relaxed space-y-1">
          <p class="font-medium text-slate-300">Polideportivo Lourdes | Cra 70 No. 1A - 30</p>
          <p class="font-medium text-slate-300">Cali - Colombia</p>
        </div>
      </div>

      <!-- COLUMNA 2: CÓMO LLEGAR -->
      <div class="space-y-3 w-full md:max-w-[240px] md:mx-auto flex flex-col items-center text-center">
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider h-10 flex items-center justify-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white opacity-80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <span>Cómo llegar</span>
        </h3>
        
        <a 
          href="https://www.google.com/maps/place/Unidad+Recreativa+de+Lourdes/@3.3930933,-76.5565273,16z/data=!4m6!3m5!1s0x8e30a3e49007f14d:0xd774fa190f6a545f!8m2!3d3.3928966!4d-76.5553301!16s%2Fg%2F1pztmh9jr?entry=ttu&g_ep=EgoyMDI2MDcxMi4wIKXMDSoASAFQAw%3D%3D" 
          target="_blank" 
          rel="noopener noreferrer"
          class="group block relative rounded-xl overflow-hidden border border-white/10 hover:border-white/30 transition-all duration-300 shadow-lg aspect-[16/8] bg-slate-950 w-full"
        >
          <Image 
            src={mapaImg} 
            alt="Ubicación de la iglesia en Google Maps" 
            class="absolute inset-0 w-full h-full object-cover opacity-50 group-hover:opacity-80 group-hover:scale-105 transition-all duration-500"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#030611]/60 via-transparent to-[#030611]/20 pointer-events-none"></div>
        </a>
      </div>

      <!-- COLUMNA 3: NUESTRAS CELEBRACIONES (MODERNO & PROFESIONAL) -->
      <div class="space-y-3 self-start flex flex-col items-center text-start w-full">
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider h-10 flex items-center justify-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white opacity-80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M8 2v4"/>
            <path d="M16 2v4"/>
            <rect width="18" height="18" x="3" y="4" rx="2"/>
            <path d="M3 10h18"/>
            <path d="M12 14v4l2 1"/>
          </svg>
          <span>Nuestras Celebraciones</span>
        </h3>
        <div class="text-sm text-slate-400 leading-relaxed space-y-1">
          <p class="font-medium text-slate-300">Miercoles 7:00 Pm</p>
          <p class="font-medium text-slate-300">Domingos 9:00 Am y 4:00 Pm</p>
        </div>
      </div>    
    </div>

    <!-- COPYRIGHT -->
    <div class="mt-8 pt-4 border-t border-white/5 text-center text-xs text-slate-500">
      <p>© 2026 Centro Mundial de Evangelismo. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>